[Unit]
Description=SStudio SAgent AI Microservice
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/app/v3
EnvironmentFile=/root/app/v3/.env
ExecStart=/root/app/v3/.venv/bin/uvicorn services.sagent.app.main:app --host 127.0.0.1 --port 8004 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
