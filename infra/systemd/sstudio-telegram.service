[Unit]
Description=SStudio Telegram Bot & Webhook Service (v3)
After=network.target postgresql.service sstudio-auth.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/app/v3
Environment="PATH=/root/app/v3/.venv/bin"
EnvironmentFile=/root/app/v3/.env
ExecStart=/root/app/v3/.venv/bin/python services/telegram/bot.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sstudio-telegram

[Install]
WantedBy=multi-user.target
