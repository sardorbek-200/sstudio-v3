[Unit]
Description=SStudio Main Portal (v3)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/app/v3
Environment="PATH=/root/app/v3/.venv/bin"
EnvironmentFile=-/root/app/v3/.env
ExecStart=/root/app/v3/.venv/bin/uvicorn services.main.app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sstudio-main

[Install]
WantedBy=multi-user.target
